# Frontend: safe to expose in the browser. Never put a service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server configuration
PORT=4242
APP_URL=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Khalti Sandbox (recommended while developing)
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=YOUR_KHALTI_SANDBOX_SECRET_KEY
PRO_MONTHLY_NPR=499
PRO_YEARLY_NPR=4999

# When approved for production, use the production API base URL and live merchant key.
# KHALTI_BASE_URL=https://khalti.com/api/v2
